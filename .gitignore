# Ignoramos la carpeta del entorno virtual (son miles de archivos de librerias, no es "nuestro codigo")
venv/
# Ignoramos las cachés que pytest y Python generan automáticamente al correr
__pycache__/
.pytest_cache/
# Ignoramos los resultados y el reporte de Allure (se generan al correr los tests)
allure-results/
allure-report/
# Ignoramos el binario portable de k6 (pesa ~63MB, no es "nuestro codigo")
tools/
